# Copy to .env and add one provider key. Keep .env private; it is ignored by git.
# Gemini is preferred when both are configured.
VISION_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Alternative OpenRouter provider; the model slug matches graphextract/extractors/opentest.py.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=qwen/qwen3-vl-30b-a3b-instruct

# Comma-separated browser origins allowed to call the API.
# Set this to the deployed Vercel URL in the API host environment.
PARSEIQ_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000,http://localhost:5174,http://127.0.0.1:5174

# Optional OCR executable path if Tesseract is not on PATH.
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
